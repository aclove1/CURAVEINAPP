# .env.example  —  template for local environment variables
#
# To add a local override:
#   1. Copy this file to `.env.local`  (gitignored)
#   2. Add KEY=value pairs below
#   3. For values that must be exposed to the browser bundle, prefix with NEXT_PUBLIC_
#
# Vercel-managed env vars are configured in the Vercel dashboard per environment
# (Development / Preview / Production). Do NOT commit production secrets here.

# ── Magic-link email gate (2026-07-07) ──
# HMAC secret for login/session tokens. Generate: openssl rand -hex 32
AUTH_SECRET=

# Resend API key (https://resend.com). Required in Production; without it in
# dev, /api/auth/request returns the login link directly for local testing.
RESEND_API_KEY=

# Verified sender (domain must be verified in Resend via Cloudflare DNS).
EMAIL_FROM="CuraVein <login@curavein.app>"

# Where access-request notifications (lead capture) are sent.
NOTIFY_EMAIL=aaronloveq@gmail.com
